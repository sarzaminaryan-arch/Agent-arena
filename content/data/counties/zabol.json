  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "آتشکده کرکویه\nقلعه سام\nقلعه رستم\nقلعه تپه\nقلعه مچی\nقلعه رامرود\nتپه زیارت تخت شاه\nآرامگاه خواجه غلطان\nارگ خان ملک کیانی\nتپه تخت شاه ۸\nمجموعه تپه‌های تخت عدالت شاه\nقلعه کک کهزاد"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "قلعه سه کوهه\nسه کوهه"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "دهانه غلامان\nچاه نیمه\nبی بی دوست\nمیل قاسم‌آباد\nمیل نادری\nزاهدان کهنه\nآسیاب بادی سیستان"
  },
