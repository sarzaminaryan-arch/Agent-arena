  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "امامزاده سید حسین\nباغ نظر\nتپه شادی\nآرامگاه شیخ ابواسحاق کازرونی\nآرامگاه شیخ امین الدین بلیانی\nآرامگاه علامه دوانی\nآرامگاه ناصر دیوان کازرونی"
  },
