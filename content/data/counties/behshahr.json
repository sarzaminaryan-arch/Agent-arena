  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "آتشکده کاووس\nپل زیر قوسی شهدای اشرف البلاد بهشهر\nباغ عباس‌آباد\nباغ‌های ایرانی"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "آبشار اسپه‌او\nرشته‌کوه البرز\nکوه سیاخانی\nجنگل\nآبشار سنگ‌نو\nکوهستان\nرشته کوه‌های البرز"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "شهرستان بهشهر\nاستان مازندران\nهزارجریب\nسپید\nزبان مازندرانی\nدوران ساسانیان\nفهرست آثار ملی ایران\nکاووس\nقباد یکم\nخسرو انوشیروان\nتوس پسر نوذر\nکیانیان"
  },
