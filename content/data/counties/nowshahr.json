  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "موزه کندلوس"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "پارک جنگلی سیسنگان\nغار قندیلی خاچک\nسد خاکی آویدر\nچشمه گردو\nدیو چشمه\nدریاچه ارواح"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "کجور\nلرگان\nصلاح الدین کلا\nبندر نوشهر\nنجارده\nاستانکرود\nکوشکسرا\nنوشهر\nچالوس\nونوش\nلاشک\nهزارخال"
  },
