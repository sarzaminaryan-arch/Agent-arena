  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "میدان ساعت ساری\nخانه کلبادی ساری\nخانه رمدانی ساری\nمسجد جامع ساری\nپل تجن ساری\nموزه ساری\nبرج رسکت ساری\nبرج سلطان زین العابدین\nامامزاده عباس ساری\nامامزاده یحیی ساری\nشاطر گنبد ساری"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "دریاچه ازنی\nدریاچه میانشه"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "دریای مازندران\nباداب سورت ساری\nفرح آباد\nدشت ناز\nازنی\nچورت\nپلسک"
  },
