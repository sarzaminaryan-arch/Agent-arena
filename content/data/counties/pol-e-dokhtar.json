  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "پل‌دختر\nپل کلهر\nکاروانسرای چمشک\nتپهٔ واشیان\nپل گاومیشان\nمقبره سید نعمت‌الله جزائری"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "غار کلماکره\nدره خزینه\nرودخانه زال\nغار کوگان\nکبیرکوه\nآبشار آبتاف\nآبشار افرینه\nتالاب بلمک\nتالاب زردابه"
  },
