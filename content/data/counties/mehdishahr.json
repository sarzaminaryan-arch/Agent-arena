  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "آب انبار تاریخی مهدی‌شهر\nامامزاده عبدالله شهمیرزاد\nامامزاده قاسم\nامامزاده یحیی شهمیرزاد\nبقعه شیخ شهمیرزاد\nحسینیه المهدی\nشکارگاه ملاده\nشیرقلعه\nعمارت کیپور\nکافرقلعه\nمسجد پامنار\nموزه عشایری ایل سنگسر"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "جنگل فینسک\nقله نیزوا\nغار دربند"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "چاشم\nچهل تن\nدرجزین\nرودبارک\nدیواره صخره‌نوردی سنگسر سل\nملاده\nمنطقه ملی گردشگری رودبارک\nمنطقه حفاظت شده پرور"
  },
