  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "آتشکده باستانی کیورز امیرآباد\nقلعه دختر\nقلعه باجول الیگودرز\nموزه مردم‌شناسی الیگودرز"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "دریاچه تمی الیگودرز\nآبشار آب سفید الیگودرز\nدریاچه گهر\nآبشار چکان الیگودرز\nآبشار برنجه الیگودرز\nدامنه‌های اشترانکوه الیگودرز\nپارک جنگلی بنفشه الیگودرز"
  },
  "poi_offbeat": {
