  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "کتیبه بیستون\nقلعه هرسین\nتپه قلعه دزد بر هرسین\nپل خسرو"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "تپه گنج‌دره\nسراب بیستون\nغار شکارچیان\nغار مرآفتاب\nغار چشمه‌سراب\nسراب هرسین\nچشمه گرماب هرسین"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "گوردخمه اسحاق‌وند\nمجسمه هرکول\nحوض سنگی\nطاق سنگی\nپلکان سنگی\nفرهاد تراش\nفرهاد تراش\nسنگ‌نبشته بیستون\nسنگ بلاش\nگوردخمه‌های اسحاق‌وند"
  },
