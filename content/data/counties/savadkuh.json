  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "برج دیو کلی\nکاروانسرای گدوک\nقلعه اولاد\nپل شاپور\nپل قدیمی پل سفید\nآرامگاه اخوت\nکلیسای سرخ‌آباد\nپل ورسک\nقلعه کنگلو"
  },
  "poi_offbeat": {
