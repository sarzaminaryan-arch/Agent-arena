  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "مسجد جامع رامشه\nمسجد جامع محمدآباد جرقویه\nخانه احمد رخشا"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "کوه محمد نوجوان\nکوه کلاه قاضی"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "دوره قاجار\nشهرستان جرقویه\nفهرست آثار ملی ایران\nقارنه\nپیشدادیان\nقارن\nکاوه آهنگر\nنصرآباد\nگیو\nگودرز\nکیانیان\nاشکانیان"
  },
