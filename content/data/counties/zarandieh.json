  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "تپه خورآباد\nتپه‌های روستای آجان\nتپه گبری الویر\nتپه قلعه باش علیشار\nتپه سر قلعه\nآب‌انبار محمودآباد\nآب‌انبار نوروزآباد\nامامزاده پنج‌تن\nآرامگاه امامزاده سید منصوربن موسی\nکاروانسرای خشکه رود\nمسجد چاله\nحمام آسیابک"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "یخچال مهدی‌آباد"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "گردشگری\nجاده ابریشم\nتاریخ ایران باستان\nدوره اشکانیان\nپیک\nمنطقه گزنگ صدرآباد\nشاهنشاهی ساسانی\nتاریخ ایران پس از اسلام\nهزاره سوم\nایران قاجاری\nایلخانان\nایران صفوی"
  },
