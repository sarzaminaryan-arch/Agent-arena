  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "قلعه اردلان\nکاروانسرای فرسفج\nمدرسه شیخ علی خان زنگنه\nمسجد جامع تویسرکان\nخانه مسعودی\nمسجد باغوار\nآرامگاه میررضی‌الدین آرتیمانی\nآرامگاه حبقوق نبی"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "مسجد جامع سرابی\nسرابی\nحمام سرابی\nدره گزندر سرابی\nآبشار افشار"
  },
  "poi_offbeat": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "اشتران\nفرسفج\nکرزان\nقاجار\nچنار\nسرکان\nروستای آرتیمان\nگشانی\nشهرستانه\nباباپیرعلی\nبوجان"
  },
