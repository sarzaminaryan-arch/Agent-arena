  "poi_heritage": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "حرم فاطمه معصومه\nمسجد جمکران\nخانه یزدانپناه\nتیمچه بزرگ قم\nقلعه قمرود\nحمام حاج عسگرخان\nکاروانسرای پاسنگان\nدیر گچین\nکاروانسرای حوض سلطان\nخانه ملاصدرا\nمجموعه راسته بازار کهنه و نو\nخانه حاج علی خان زند"
  },
  "poi_nature": {
   "fetched": "2026-10-02",
   "note": "نام‌های استخراج‌شده از بخش جاذبه‌های ویکی‌پدیای فارسی — توضیح و فاصله را خودتان بیفزایید",
   "source": "derived",
   "status": "auto",
   "url": "",
   "value": "کوه خضر نبی\nگنبد نمکی قم\nکوه دوبرادران\nغار کهک\nمجموعه معادن چاله غار وشنوه\nتنگه قاهان"
  },
